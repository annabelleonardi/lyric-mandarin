{
  "name": "lyric-mandarin",
  "displayName": "LyricMandarin",
  "version": "1.0.0",
  "description": "Learn Mandarin from song lyrics — pinyin, HSK level, and cultural meaning.",
  "author": "Annabel",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://music.163.com/*",
      "https://www.youtube.com/*",
      "https://www.youtube-nocookie.com/*",
      "https://api.deepseek.com/*",
      "https://api.openai.com/*"
    ]
  }
}
